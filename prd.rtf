\f0\b\fs28 \cf0 6.3 Data Flow\
\pard\pardeftab720\partightenfactor0

\f5\b0\fs26 \cf0 User submits entry\
    
\f7 \uc0\u8595 
\f5 \
[Logbook Service]\
    
\f7 \uc0\u9500 \u9472 
\f5  Save raw entry to PostgreSQL\
    
\f7 \uc0\u9500 \u9472 
\f5  Call OpenAI (GPT-4o mini) for categorization\
    
\f7 \uc0\u9500 \u9472 
\f5  Create "object" in database\
    
\f7 \uc0\u9492 \u9472 
\f5  Return object to frontend\
    
\f7 \uc0\u8595 
\f5 \
[Loft State Service]\
    
\f7 \uc0\u9500 \u9472 
\f5  Listen for new entries (Redis pub/sub)\
    
\f7 \uc0\u9500 \u9472 
\f5  Aggregate objects into room state\
    
\f7 \uc0\u9500 \u9472 
\f5  Cache in Redis\
    
\f7 \uc0\u9492 \u9472 
\f5  Send to frontend via WebSocket (future)\
    
\f7 \uc0\u8595 
\f5 \
[Frontend]\
    
\f7 \uc0\u9500 \u9472 
\f5  Receive object\
    
\f7 \uc0\u9500 \u9472 
\f5  Animate object into room (Framer Motion)\
    
\f7 \uc0\u9492 \u9472 
\f5  Display to user\
\pard\pardeftab720\sa280\partightenfactor0

